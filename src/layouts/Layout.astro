---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import { ClientRouter } from 'astro:transitions';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth font-sans bg-[#000000] overflow-x-hidden">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class="min-h-full flex flex-col text-white relative">
		<div class="fixed inset-0 -z-10 bg-[#000000] bg-[radial-gradient(#ffffff33_1px,#00091d_1px)] bg-size-[20px_20px] pointer-events-none"></div>
		<Navbar />
		<main class="flex-1 w-full max-w-300 mx-auto px-6 box-border">
			<slot />
		</main>
		<Footer />
	</body>
</html>
