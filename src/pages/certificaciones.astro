---

<Layout title="Certificaciones y Cursos | Camilo Le Fort">
  <div class="py-12 md:py-16">
    
    <!-- Botón Volver y Header -->
    <div class="mb-12">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 text-sm font-semibold text-slate-400 hover:text-white transition-colors duration-200 mb-6 group no-underline"
      >
        <Icon name="tabler:arrow-left" class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-1" />
        Volver al Inicio
      </a>

      <div class="flex items-center gap-3 mb-3">
        <span class="p-2 rounded-lg bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          <Icon name="tabler:school" class="w-6 h-6" />
        </span>
        <span class="text-indigo-400 text-sm font-bold uppercase tracking-wider">Aprendizaje Continuo & Rendimiento</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
        Certificaciones, Cursos & Módulos
      </h1>
      <p class="text-slate-400 text-base md:text-lg max-w-200 leading-relaxed m-0">
        Resumen de mis certificaciones de la industria, cursos técnicos y asignaturas de ingeniería cursadas con rendimiento sobresaliente en Duoc UC.
      </p>
    </div>

    <!-- SECCIÓN 1: CERTIFICACIONES OFICIALES -->
    <section class="mb-20">
      <div class="flex items-center gap-3 mb-8 pb-3 border-b border-white/10">
        <Icon name="tabler:certificate" class="text-2xl text-indigo-400" />
        <h2 class="text-2xl font-bold text-white m-0">Certificaciones Oficiales</h2>
        <span class="ml-auto text-xs px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-400 font-semibold border border-indigo-500/20">
          {certificaciones.length} Validadas
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {certificaciones.map((cert) => (
          <div 
            class="flex flex-col justify-between bg-[#0a0a0c]/90 border border-white/10 hover:border-white/20 rounded-2xl p-6 md:p-7 shadow-[0_4px_20px_rgba(0,0,0,0.4)] hover:shadow-[0_8px_30px_rgba(0,0,0,0.6)] transition-all duration-300 ease-out hover:-translate-y-1 relative overflow-hidden group"
          >
            <div class="absolute top-0 left-0 right-0 h-1" style={`background-color: ${cert.color}`}></div>

            <div>
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="w-14 h-14 rounded-xl flex items-center justify-center shrink-0 border border-white/10 bg-white/5 group-hover:scale-105 transition-transform duration-300">
                  <Icon name={cert.icon} class="text-3xl" style={`color: ${cert.color}`} />
                </div>
                <div class="text-right">
                  <span class="inline-block text-xs font-bold uppercase tracking-wider text-slate-400 bg-white/5 px-2.5 py-1 rounded-md border border-white/5">
                    {cert.idCredencial}
                  </span>
                  <small class="block text-slate-500 text-xs mt-1">{cert.fecha}</small>
                </div>
              </div>

              <h3 class="text-xl font-bold text-white mb-1.5 leading-snug">
                {cert.nombre}
              </h3>
              <p class="text-sm font-medium text-indigo-400 mb-3">
                {cert.emisor}
              </p>

              <p class="text-slate-300 text-sm leading-relaxed mb-6">
                {cert.descripcion}
              </p>

              <div class="flex flex-wrap gap-2 mb-6">
                {cert.habilidades.map((habilidad) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-slate-300 font-medium">
                    {habilidad}
                  </span>
                ))}
              </div>
            </div>

            {cert.url && (
              <div class="pt-4 border-t border-white/5">
                <a 
                  href={cert.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl text-xs font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all duration-200 no-underline group/link"
                >
                  <Icon name="tabler:certificate" class="text-base text-emerald-400" />
                  <span>Verificar Credencial Oficial</span>
                  <Icon name="tabler:external-link" class="w-3.5 h-3.5 text-slate-400 group-hover/link:text-white transition-colors" />
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN 2: CURSOS Y CAPACITACIONES -->
    <section class="mb-20">
      <div class="flex items-center gap-3 mb-8 pb-3 border-b border-white/10">
        <Icon name="tabler:books" class="text-2xl text-emerald-400" />
        <h2 class="text-2xl font-bold text-white m-0">Cursos & Capacitaciones Realizadas</h2>
        <span class="ml-auto text-xs px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 font-semibold border border-emerald-500/20">
          Formación Práctica
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cursos.map((curso) => (
          <div class="flex flex-col justify-between bg-[#0a0a0c]/80 border border-white/10 hover:border-white/20 rounded-2xl p-6 transition-all duration-300 hover:bg-white/2">
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center border border-white/10 bg-white/5">
                  <Icon name={curso.icono} class="text-xl" style={`color: ${curso.color}`} />
                </div>
                <span class="text-xs text-slate-400 font-semibold bg-white/5 px-2 py-0.5 rounded border border-white/5">
                  {curso.horas}
                </span>
              </div>

              <h3 class="text-lg font-bold text-white mb-1 leading-snug">
                {curso.titulo}
              </h3>
              <p class="text-xs font-medium text-emerald-400 mb-3">
                {curso.plataforma} • <span class="text-slate-400">{curso.año}</span>
              </p>

              <p class="text-slate-400 text-xs leading-relaxed mb-4">
                {curso.descripcion}
              </p>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {curso.tags.map((tag) => (
                  <span class="text-[0.7rem] px-2 py-0.5 rounded bg-white/5 text-slate-300 border border-white/5 font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            {curso.urlCertificado ? (
              <a 
                href={curso.urlCertificado} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-xs text-indigo-400 hover:text-indigo-300 font-medium no-underline pt-3 border-t border-white/5"
              >
                <Icon name="tabler:file-certificate" /> Ver certificado
              </a>
            ) : (
              <div class="pt-3 border-t border-white/5 flex items-center gap-1.5 text-xs text-slate-500">
                <Icon name="tabler:check" class="text-emerald-500" /> Competencias asimiladas
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- SECCIÓN 3: MÓDULOS ACADÉMICOS DESTACADOS (Duoc UC) -->
    <section>
      <div class="flex items-center gap-3 mb-8 pb-3 border-b border-white/10">
        <Icon name="tabler:school" class="text-2xl text-indigo-400" />
        <div>
          <h2 class="text-2xl font-bold text-white m-0">Módulos Académicos Técnicos</h2>
          <small class="text-slate-400 text-xs">Ingeniería en Informática · Duoc UC</small>
        </div>
        <span class="ml-auto text-xs px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-300 font-semibold border border-indigo-500/20">
          Formación Universitaria
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {modulosAcademicos.map((mod) => (
          <div class="flex flex-col justify-between bg-[#0a0a0c]/85 border border-white/10 hover:border-white/20 rounded-2xl p-6 transition-all duration-300 relative overflow-hidden group">
            
            <div class="absolute top-0 left-0 right-0 h-1" style={`background-color: ${mod.color}`}></div>

            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-11 h-11 rounded-xl flex items-center justify-center border border-white/10 bg-white/5">
                  <Icon name={mod.icono} class="text-2xl" style={`color: ${mod.color}`} />
                </div>
                <h3 class="text-lg font-bold text-white m-0 leading-tight">
                  {mod.modulo}
                </h3>
              </div>

              <p class="text-slate-400 text-xs leading-relaxed mb-6">
                {mod.descripcion}
              </p>

              <!-- Lista de Asignaturas con Notas -->
              <div class="space-y-3 mb-6">
                <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">
                  Asignaturas Cursadas
                </span>
                {mod.asignaturas.map((asig) => (
                  <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-white/5 border border-white/5 hover:border-white/10 transition-colors">
                    <span class="text-xs text-white font-medium leading-snug">
                      {asig.nombre}
                    </span>
                    <div class="flex items-center gap-1.5 shrink-0">
                      <span class="text-xs font-bold text-emerald-400 bg-emerald-500/15 border border-emerald-500/30 px-2 py-0.5 rounded-md">
                        {asig.nota}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Tags -->
            <div class="pt-4 border-t border-white/5">
              <div class="flex flex-wrap gap-1.5">
                {mod.tags.map((tag) => (
                  <span class="text-[0.7rem] px-2 py-0.5 rounded-md bg-white/5 text-slate-300 border border-white/5 font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>