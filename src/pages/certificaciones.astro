      { nombre: "Ciberseguridad Ofensiva", nota: "6.7" }
    ],
    tags: ["Automatización de Pruebas", "Selenium", "Gestión de Personas en TI", "Capacitación", "Competencias técnicas", "Pentesting", "Kali Linux", "Metasploit", "Nmap"],
