---
import { Icon } from 'astro-icon/components';

const links = [
  { name: 'Inicio', href: '/' },
  { name: 'Sobre mí', href: '#sobre-mi' },
  { name: 'Proyectos', href: '#proyectos-destacados' },
  { name: 'Contacto', href: '#contacto' },
];
---

<nav id="navbar" class="fixed top-0 left-0 w-full z-50 bg-[#171717]/80 backdrop-blur-[10px] border-b border-white/10 transition-transform duration-300 ease-in-out [&.nav-hidden]:-translate-y-full">
  <div class="max-w-300 mx-auto px-4 md:px-8 py-4 flex justify-between items-center">
    <div>
      <a href="/" class="text-2xl font-bold text-white no-underline">Camilo Le Fort</a>
    </div>

    <button id="menu-toggle" class="block md:hidden bg-transparent border-0 text-white text-[2rem] cursor-pointer p-0" aria-label="Abrir menú">
      <Icon name="tabler:menu-2" class="icon-menu w-8 h-8" />
      <Icon name="tabler:x" class="icon-close hidden w-8 h-8" />
    </button>
  
    <ul id="nav-links" class="list-none m-0 flex flex-col items-center absolute top-full left-0 w-full bg-[#171717] py-8 gap-6 border-b border-white/10 opacity-0 invisible -translate-y-2.5 transition-all duration-300 ease-in-out [&.active]:opacity-100 [&.active]:visible [&.active]:translate-y-0 md:static md:flex-row md:items-center md:w-auto md:bg-transparent md:p-0 md:gap-8 md:border-b-0 md:opacity-100 md:visible md:translate-y-0">
      {links.map((link) => (
        <li>
          <a href={link.href} class="text-[#e5e5e5] no-underline font-medium transition-colors duration-300 hover:text-indigo-500">{link.name}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  document.addEventListener('astro:page-load', () => {
    const navbar = document.getElementById('navbar');
    const menuToggle = document.getElementById('menu-toggle');
    const navLinks = document.getElementById('nav-links');
    const iconMenu = document.querySelector('.icon-menu');
    const iconClose = document.querySelector('.icon-close');

    if (!navbar || !menuToggle || !navLinks || !iconMenu || !iconClose) return;

    // --- LÓGICA DEL MENÚ MÓVIL (La que ya tenías) ---
    menuToggle.addEventListener('click', () => {
      navLinks.classList.toggle('active');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    // --- NUEVA LÓGICA: SCROLL INTELIGENTE ---
    let lastScrollY = window.scrollY;
    
    window.addEventListener('scroll', () => {
      // 1. Obtenemos posición actual
      const currentScrollY = window.scrollY;
      
      // 2. Si bajamos Y ya pasamos el top de la página...
      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        // ... ocultamos el navbar
        navbar.classList.add('nav-hidden');
        
        // (Opcional) Cerramos el menú móvil si estaba abierto al hacer scroll
        navLinks.classList.remove('active');
        iconMenu.classList.remove('hidden');
        iconClose.classList.add('hidden');

      } else {
        // 3. Si subimos, lo mostramos
        navbar.classList.remove('nav-hidden');
      }

      // 4. Actualizamos la última posición
      lastScrollY = currentScrollY;
    });
  });
</script>