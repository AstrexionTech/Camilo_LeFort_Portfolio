---

<section class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 py-8 max-w-250 mx-auto">
  
  <!-- COLUMNA IZQUIERDA -->
  <div class="flex flex-col">
    
    <!-- BLOQUE 1: EXPERIENCIA LABORAL -->
    <div class="reveal-chunk mb-16">
      <h3 class="flex items-center gap-2 text-2xl text-white mb-8 border-b-2 border-indigo-500/30 pb-2">
        <Icon name="tabler:briefcase" /> Experiencia Laboral
      </h3>
      
      <div class="relative border-l-2 border-white/10 ml-4 pl-8">
        {trabajos.map((job) => (
          <div class="relative mb-12">
            <!-- Punto animado con halo suave -->
            <div class="absolute left-[-2.6rem] top-0 w-4 h-4 rounded-full border-[3px] border-[#1a1a1a] bg-indigo-500 shadow-[0_0_12px_rgba(99,102,241,0.6)]">
              <span class="absolute inset-0 rounded-full bg-indigo-400 animate-ping opacity-40"></span>
            </div>
            <div>
              <span class="text-[0.85rem] text-indigo-400 font-semibold uppercase tracking-wider">{job.fecha}</span>
              <h4 class="mt-2 mb-1 text-[1.2rem] text-white font-bold">{job.titulo}</h4>
              <span class="block italic text-[#bbb] mb-3">{job.empresa}</span>
              <ul class="mt-3 pl-5 list-disc text-justify space-y-1.5 marker:text-indigo-500">
                {job.desc.map((item) => <li class="text-white text-[0.95rem] leading-[1.6]">{item}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- BLOQUE 2: EDUCACIÓN -->
    <div class="reveal-chunk mb-16">
      <h3 class="flex items-center gap-2 text-2xl text-white mb-8 border-b-2 border-indigo-500/30 pb-2">
        <Icon name="tabler:school" /> Educación
      </h3>
      
      <div class="relative border-l-2 border-white/10 ml-4 pl-8">
        {estudios.map((edu) => (
          <div class="relative mb-12">
            <div class="absolute -left-12 top-0 w-[1.8rem] h-[1.8rem] rounded-full border-[3px] border-[#1a1a1a] bg-emerald-500 shadow-[0_0_12px_rgba(16,185,129,0.6)] flex items-center justify-center text-black text-base">
              <Icon name="tabler:book" />
            </div>
            
            <div>
              <span class="text-[0.85rem] text-indigo-400 font-semibold uppercase tracking-wider">{edu.fecha}</span>
              <h4 class="mt-2 mb-1 text-[1.2rem] text-white font-bold">{edu.titulo}</h4>
              <span class="block italic text-[#bbb] mb-3">{edu.institucion}</span>
              <p class="text-white text-[0.95rem] leading-normal m-0 text-justify">{edu.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- COLUMNA DERECHA -->
  <div class="flex flex-col">
    
    <!-- BLOQUE 3: CERTIFICACIONES DESTACADAS -->
    <div class="reveal-chunk mb-12">
      <h3 class="flex items-center gap-2 text-2xl text-white mb-8 border-b-2 border-indigo-500/30 pb-2">
        <Icon name="tabler:certificate" /> Certificaciones Destacadas
      </h3>
      
      <div class="flex flex-col gap-4 mb-4">
        {certs.map((cert) => (
          <div 
            class="group flex items-start gap-4 bg-[#0a0a0c]/90 hover:bg-[#141418] p-5 rounded-xl border border-white/8 hover:border-white/20 shadow-[0_4px_10px_rgba(0,0,0,0.4)] hover:shadow-[0_8px_20px_rgba(0,0,0,0.6)] transition-all duration-300 ease-out hover:translate-x-1.5" 
            style={`border-left: 4px solid ${cert.color}`}
          >
            <Icon 
              name={cert.icon} 
              class="text-[2rem] shrink-0 mt-1 transition-transform duration-300 group-hover:scale-110" 
              style={`color: ${cert.color}`} 
            />
            <div class="flex flex-col">
              <h4 class="m-0 mb-1 text-white text-base leading-snug font-bold group-hover:text-indigo-300 transition-colors">
                {cert.nombre}
              </h4>
              <small class="text-[#888] block mb-3 text-xs">{cert.empresa} • {cert.fecha}</small>
              {cert.url && (
                <a 
                  href={cert.url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="inline-flex items-center gap-1.5 text-xs text-[#ccc] hover:text-white no-underline bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded w-fit transition-all duration-200"
                >
                  <Icon name="tabler:external-link" /> Ver Credencial
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <a 
        href="/certificaciones/" 
        class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl text-sm font-semibold text-indigo-300 bg-indigo-500/10 border border-indigo-500/20 hover:bg-indigo-500/20 hover:border-indigo-500/40 hover:text-white transition-all duration-200 no-underline group mb-12"
      >
        <span>Ver todas las certificaciones y cursos</span>
        <Icon name="tabler:arrow-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" />
      </a>
    </div>

    <!-- BLOQUE 4: TECH STACK -->
    <div class="reveal-chunk">
      <h3 class="flex items-center gap-2 text-2xl text-white mb-8 border-b-2 border-indigo-500/30 pb-2">
        <Icon name="tabler:tools" /> Tech Stack
      </h3>
      
      {skillCategories.map((cat) => (
        <div class="mb-6">
          <span class="block text-[0.9rem] text-[#bbb] mb-3 font-semibold">{cat.name}</span>
          <div class="flex flex-wrap gap-2.5">
            {cat.items.map((skill) => (
              <span class={`group/skill inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[0.85rem] font-semibold tracking-[0.5px] border transition-all duration-200 ease-out hover:-translate-y-0.5 hover:scale-[1.03] ${cat.tagClass}`}>
                {skill.icon && <Icon name={skill.icon} class="w-4 h-4 shrink-0 transition-transform duration-200 group-hover/skill:scale-115" />}
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>

</section>

<script>
  function initExperienceReveal() {
    const chunks = document.querySelectorAll('.reveal-chunk');
    if (!chunks.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    chunks.forEach((chunk) => observer.observe(chunk));
  }

  document.addEventListener('astro:page-load', initExperienceReveal);
</script>

<style>
  /* Estado base de cada gran bloque */
  .reveal-chunk {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Estado al entrar en pantalla */
  .reveal-chunk.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>