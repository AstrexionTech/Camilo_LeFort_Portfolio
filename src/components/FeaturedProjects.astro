---
import { Icon } from 'astro-icon/components';

// ==========================================
// PROYECTOS DESTACADOS PARA LA PÁGINA DE INICIO
// (Aquí puedes editar o seleccionar tus mejores 2 proyectos)
// ==========================================
const proyectosDestacados = [
  {
    titulo: "Proyecto Capstone - CowTracker",
    tipo: "Proyecto de Titulación · Duoc UC",
    descripcion: "Solución integral desarrollada como proyecto de Capstone en Duoc UC. Diseñada bajo una arquitectura por capas y APIs RESTful seguras, incorporando autenticación por tokens JWT, acceso a datos optimizado y despliegue contenerizado.",
    // Si tienes una imagen, colócala en /public/images/proyectos/capstone.png y pon su ruta aquí:
    // imagen: "/images/proyectos/capstone.png",
    imagen: "", // Déjalo vacío si aún no tienes imagen para usar el visor técnico por defecto
    destacado: true,
    stack: [
      { nombre: "Next.js", icono: "simple-icons:nextdotjs" },
      { nombre: "React Native", icono: "simple-icons:react" },
      { nombre: "TypeScript", icono: "simple-icons:typescript" },
      { nombre: "Express.js", icono: "simple-icons:express" },
      { nombre: "FastAPI", icono: "simple-icons:fastapi" },
      { nombre: "Python", icono: "simple-icons:python" },
      { nombre: "PostgreSQL", icono: "simple-icons:postgresql" },
      { nombre: "Docker", icono: "simple-icons:docker" },
      { nombre: "Git", icono: "simple-icons:git" },
      { nombre: "GitHub", icono: "simple-icons:github" },
    ],
    enlaces: {
      github: "https://github.com/lucassmelendez/cowtracker", // Reemplaza con el link directo a tu repositorio
      demo: "",    // Opcional: link a demo web si existe
      swagger: "", // Opcional: link a documentación Swagger o Postman
    }
  },

  // -------------------------------------------------------------
  // PLANTILLA EJEMPLO: Copia desde aquí para agregar otro proyecto
  // -------------------------------------------------------------
  {
    titulo: "E-commerce Ferretería 'Ferremax'",
    tipo: "Proyecto Académico · Integración de Plataformas",
    descripcion: "Desarrollo de un e-commerce completo para una ferretería ficticia, integrando un frontend moderno con Vue.js y Nuxt.js, y un backend robusto con ASP.NET Core Web API y FastAPI. Implementación de autenticación, gestión de productos, carrito de compras y procesamiento de pagos con Mercado Pago.",
    imagen: "", // Ruta a la imagen o vacío para plantilla
    destacado: false,
    stack: [
      { nombre: "ASP.NET Core Web API", icono: "simple-icons:dotnet" },
      { nombre: "C#", icono: "simple-icons:csharp" },
      { nombre: "FastAPI", icono: "simple-icons:fastapi" },
      { nombre: "Python", icono: "simple-icons:python" },
      { nombre: "Nuxt.js", icono: "simple-icons:nuxt" },
      { nombre: "Vue.js", icono: "simple-icons:vuedotjs" },
      { nombre: "TypeScript", icono: "simple-icons:typescript" },
      { nombre: "PostgreSQL", icono: "simple-icons:postgresql" },
      { nombre: "Docker", icono: "simple-icons:docker" },
      { nombre: "Git", icono: "simple-icons:git" },
      { nombre: "GitHub", icono: "simple-icons:github" },
    ],
    enlaces: {
      github: "https://github.com/AstrexionTech",
      demo: "",
      swagger: "",
    }
  },
];
---

<section id="proyectos-destacados" class="w-full py-16 md:py-24 border-t border-white/5 scroll-mt-20">
  
  <!-- Encabezado de la sección -->
  <div class="reveal-header max-w-250 mx-auto mb-12">
    <div class="flex items-center gap-3 mb-2 pb-2 border-b-2 border-indigo-500/30">
      <Icon name="tabler:folders" class="text-3xl text-indigo-400" />
      <h2 class="text-2xl md:text-3xl font-bold text-white m-0">Proyectos Destacados</h2>
    </div>
    <p class="text-slate-400 text-sm md:text-base m-0 mt-3">
      Una muestra de mis trabajos más representativos en desarrollo backend, arquitectura y datos.
    </p>
  </div>

  <!-- Cuadrícula de Proyectos Destacados (2 columnas) -->
  <div class="max-w-250 mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
    {proyectosDestacados.map((proyecto) => (
      <article class="reveal-card flex flex-col bg-[#0a0a0c]/90 border border-white/10 hover:border-indigo-500/40 rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.5)] hover:shadow-[0_10px_30px_rgba(99,102,241,0.15)] transition-all duration-300 group">
        
        <!-- Zona de imagen o visualizador técnico -->
        <div class="w-full h-48 bg-[#141418] relative overflow-hidden border-b border-white/10 flex items-center justify-center">
          {proyecto.imagen ? (
            <img 
              src={proyecto.imagen} 
              alt={proyecto.titulo} 
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" 
            />
          ) : (
            <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-radial from-indigo-950/30 via-[#0e0e12] to-[#0a0a0c]">
              <div class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center mb-2 group-hover:border-indigo-500/50 group-hover:scale-110 transition-all duration-300">
                <Icon name="tabler:server-2" class="text-2xl text-indigo-400" />
              </div>
              <span class="text-[0.7rem] uppercase tracking-widest text-slate-500 font-mono">Backend Architecture & API</span>
            </div>
          )}

          <span class="absolute top-3 left-3 text-xs font-semibold px-2.5 py-0.5 rounded-full bg-[#111116]/80 backdrop-blur-md border border-white/15 text-indigo-300">
            {proyecto.tipo}
          </span>
        </div>

        <!-- Contenido -->
        <div class="p-6 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="text-lg md:text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors">
              {proyecto.titulo}
            </h3>

            <p class="text-slate-300 text-xs md:text-sm leading-relaxed mb-4 text-justify">
              {proyecto.descripcion}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {proyecto.stack.map((tech) => (
                <span class="inline-flex items-center gap-1 text-[0.75rem] px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-slate-200 font-medium">
                  {tech.icono && <Icon name={tech.icono} class="w-3 h-3 text-indigo-400" />}
                  {tech.nombre}
                </span>
              ))}
            </div>
          </div>

          <!-- Enlaces -->
          <div class="pt-4 border-t border-white/10 flex flex-wrap gap-2 items-center">
            {proyecto.enlaces.github && (
              <a 
                href={proyecto.enlaces.github} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-white/5 hover:bg-white/15 border border-white/10 transition-all no-underline"
              >
                <Icon name="tabler:brand-github" class="text-sm" />
                <span>GitHub</span>
              </a>
            )}
            {proyecto.enlaces.demo && (
              <a 
                href={proyecto.enlaces.demo} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-indigo-400 bg-indigo-500/10 hover:bg-indigo-500/20 border border-indigo-500/20 transition-all no-underline"
              >
                <Icon name="tabler:external-link" class="text-sm" />
                <span>Demo</span>
              </a>
            )}
          </div>

        </div>

      </article>
    ))}
  </div>

  <!-- Botón hacia todos los proyectos -->
  <div class="reveal-button flex justify-center max-w-250 mx-auto">
    <a 
      href="/proyectos/" 
      class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm text-indigo-300 bg-indigo-500/10 border border-indigo-500/20 hover:bg-indigo-500/20 hover:border-indigo-500/40 hover:text-white transition-all duration-200 no-underline group shadow-lg shadow-indigo-500/5 hover:-translate-y-0.5"
    >
      <span>Ver todos los proyectos</span>
      <Icon name="tabler:arrow-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" />
    </a>
  </div>

</section>

<script>
  function initFeaturedProjectsReveal() {
    const section = document.getElementById('proyectos-destacados');
    if (!section) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add('is-visible');
            observer.disconnect();
          }
        });
      },
      { threshold: 0.12 }
    );

    observer.observe(section);
  }

  document.addEventListener('astro:page-load', initFeaturedProjectsReveal);
</script>

<style>
  .reveal-header, .reveal-card, .reveal-button {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(#proyectos-destacados.is-visible) .reveal-header {
    opacity: 1;
    transform: translateY(0);
  }

  :global(#proyectos-destacados.is-visible) .reveal-card {
    opacity: 1;
    transform: translateY(0);
  }

  :global(#proyectos-destacados.is-visible) .reveal-button {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 200ms;
  }
</style>