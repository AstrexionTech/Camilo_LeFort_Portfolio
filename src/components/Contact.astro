---
import { Icon } from 'astro-icon/components';

// ==========================================
// TUS DATOS DE CONTACTO (Edita tus enlaces aquí)
// ==========================================
const email = "camilolefort.g2004@outlook.com"; // <-- Reemplaza con tu correo real
const linkedinUrl = "https://www.linkedin.com/in/camilo-le-fort/"; // <-- Reemplaza con tu URL de LinkedIn
const githubUrl = "https://github.com/AstrexionTech";
---

<section id="contacto" class="w-full py-16 md:py-24 border-t border-white/5 scroll-mt-20 overflow-hidden">
  
  <div class="reveal-contact max-w-250 mx-auto">
    
    <!-- Encabezado de la sección -->
    <div class="text-center max-w-160 mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold mb-4">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Bandeja de entrada abierta
      </div>

      <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight mb-4">
        ¿Tienes una oportunidad o proyecto en mente?
      </h2>

      <p class="text-slate-400 text-base md:text-lg leading-relaxed m-0">
        Actualmente estoy disponible para comenzar mi <strong class="text-slate-200">práctica profesional</strong> en desarrollo Backend (.NET, SQL, Docker). ¡Conectemos y conversemos!
      </p>
    </div>

    <!-- Contenedor de Tarjetas de Contacto -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      
      <!-- 1. CORREO ELECTRÓNICO (Con botón de copiar interactivo) -->
      <div class="flex flex-col justify-between bg-[#0a0a0c]/90 border border-white/10 hover:border-indigo-500/40 rounded-2xl p-6 transition-all duration-300 group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <Icon name="tabler:mail" class="text-2xl" />
          </div>

          <h3 class="text-lg font-bold text-white mb-1">
            Correo Electrónico
          </h3>
          <p class="text-xs text-slate-400 mb-4">
            Respondo directamente a tu mensaje
          </p>

          <span class="block text-xs font-mono text-slate-300 bg-white/5 px-3 py-2 rounded-lg border border-white/5 break-all mb-4 select-all">
            {email}
          </span>
        </div>

        <div class="flex items-center gap-2 pt-2 border-t border-white/5">
          <a 
            href={`mailto:${email}`}
            class="flex-1 inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold text-white bg-indigo-500 hover:bg-indigo-600 transition-colors no-underline"
          >
            <Icon name="tabler:send" class="text-sm" />
            <span>Escribir</span>
          </a>

          <button 
            id="copy-email-btn"
            data-email={email}
            type="button"
            class="inline-flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-semibold text-slate-300 bg-white/5 hover:bg-white/10 border border-white/10 hover:text-white transition-all cursor-pointer"
            title="Copiar correo al portapapeles"
          >
            <Icon name="tabler:copy" id="copy-icon" class="text-sm" />
            <Icon name="tabler:check" id="check-icon" class="text-sm text-emerald-400 hidden" />
            <span id="copy-text">Copiar</span>
          </button>
        </div>
      </div>

      <!-- 2. LINKEDIN -->
      <div class="flex flex-col justify-between bg-[#0a0a0c]/90 border border-white/10 hover:border-sky-500/40 rounded-2xl p-6 transition-all duration-300 group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <Icon name="tabler:brand-linkedin" class="text-2xl" />
          </div>

          <h3 class="text-lg font-bold text-white mb-1">
            LinkedIn
          </h3>
          <p class="text-xs text-slate-400 mb-4">
            Mi red profesional y trayectoria
          </p>

          <p class="text-xs text-slate-300 leading-relaxed mb-6">
            Conectemos para conversar sobre oportunidades laborales, pasantías o proyectos de ingeniería.
          </p>
        </div>

        <div class="pt-2 border-t border-white/5">
          <a 
            href={linkedinUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-lg text-xs font-semibold text-white bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/30 hover:border-sky-500/50 transition-all no-underline group/link"
          >
            <span>Conectar en LinkedIn</span>
            <Icon name="tabler:external-link" class="text-sm text-sky-400 group-hover/link:translate-x-0.5 transition-transform" />
          </a>
        </div>
      </div>

      <!-- 3. GITHUB & UBICACIÓN -->
      <div class="flex flex-col justify-between bg-[#0a0a0c]/90 border border-white/10 hover:border-white/30 rounded-2xl p-6 transition-all duration-300 group">
        <div>
          <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 text-white flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <Icon name="tabler:brand-github" class="text-2xl" />
          </div>

          <h3 class="text-lg font-bold text-white mb-1">
            GitHub & Ubicación
          </h3>
          <p class="text-xs text-slate-400 mb-4">
            Código abierto y disponibilidad
          </p>

          <div class="space-y-2 mb-6">
            <div class="flex items-center gap-2 text-xs text-slate-300">
              <Icon name="tabler:map-pin" class="text-indigo-400 shrink-0" />
              <span>Santiago, Chile</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-300">
              <Icon name="tabler:briefcase" class="text-emerald-400 shrink-0" />
              <span>Remoto / Híbrido / Presencial</span>
            </div>
          </div>
        </div>

        <div class="pt-2 border-t border-white/5">
          <a 
            href={githubUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full inline-flex items-center justify-center gap-2 py-2 px-4 rounded-lg text-xs font-semibold text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 transition-all no-underline group/link"
          >
            <span>Ver perfil de GitHub</span>
            <Icon name="tabler:external-link" class="text-sm text-slate-400 group-hover/link:translate-x-0.5 transition-transform" />
          </a>
        </div>
      </div>

    </div>

  </div>

</section>

<script>
  function initContactInteractions() {
    // 1. Lógica del botón Copiar Correo
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-text');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');

    if (copyBtn && copyText && copyIcon && checkIcon) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || '';
        
        try {
          await navigator.clipboard.writeText(email);
          
          // Feedback visual
          copyText.textContent = '¡Copiado!';
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          copyBtn.classList.add('bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-400');

          setTimeout(() => {
            copyText.textContent = 'Copiar';
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            copyBtn.classList.remove('bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-400');
          }, 2000);
        } catch (err) {
          console.error('Error al copiar correo:', err);
        }
      });
    }

    // 2. Animación de revelado al hacer scroll
    const section = document.getElementById('contacto');
    if (section) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.disconnect();
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(section);
    }
  }

  document.addEventListener('astro:page-load', initContactInteractions);
</script>

<style>
  .reveal-contact {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(#contacto.is-visible) .reveal-contact {
    opacity: 1;
    transform: translateY(0);
  }
</style>